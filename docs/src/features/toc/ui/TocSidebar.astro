---
import type { MarkdownHeading } from "astro";

// Shared imports
import {
  INVERSE_FOCUS_RING_CLASS,
  TOC_BACKDROP_CLASS,
  TOC_NAV_CLASS,
  TOC_PANEL_CLASS,
  TOC_SIDEBAR_CLASS,
} from "../../../shared/ui/tailwind";

// Internal slice imports
import { TOC_IDS, TOC_LABELS } from "../lib/config";
import { renderTocHtml } from "../lib/render";

interface Props {
  tocMode?: "auto" | "off";
  headings?: MarkdownHeading[];
}

const { tocMode = "auto", headings = [] }: Props = Astro.props;
const hidden = tocMode === "off";
const tocHtml = hidden ? "" : renderTocHtml(headings);

// Упрощенные классы. Использован паттерн "group" для управления иконками по aria-expanded
const toggleClass = [
  "group fixed bottom-[calc(var(--space-xl)+60px)] left-lg z-toc-fab flex size-12 items-center justify-center rounded-full",
  "bg-[linear-gradient(135deg,var(--color-header-bg),var(--color-header-bg-end))] text-text-inverse shadow-md",
  "transition-[background,transform,opacity] duration-200 ease-[cubic-bezier(0.4,0,0.2,1)]",
  "hover:scale-[1.06] hover:bg-[linear-gradient(135deg,var(--color-header-bg-end),var(--color-header-bg))]",
  "active:scale-95 wide:hidden",
  INVERSE_FOCUS_RING_CLASS,
].join(" ");

const closeButtonClass = [
  "flex min-h-11 min-w-11 items-center justify-center rounded bg-transparent text-overlay-inverse-85",
  "transition-[color,background-color] duration-200 ease-[cubic-bezier(0.4,0,0.2,1)]",
  "hover:bg-overlay-inverse-14 hover:text-text-inverse wide:hidden",
  INVERSE_FOCUS_RING_CLASS,
].join(" ");
---

<aside class={TOC_SIDEBAR_CLASS} id={TOC_IDS.sidebar} aria-labelledby={TOC_IDS.heading} hidden={hidden}>
  <button
    class={toggleClass}
    id={TOC_IDS.toggle}
    aria-label={TOC_LABELS.open}
    aria-expanded="false"
    aria-controls={TOC_IDS.panel}
    type="button"
  >
    <!-- Иконки используют group-aria-expanded вместо сложных Arbitrary Variants на родителе -->
    <svg class="absolute size-5 transition-[opacity,transform] duration-200 ease-[cubic-bezier(0.4,0,0.2,1)] group-aria-expanded:-rotate-90 group-aria-expanded:scale-[0.6] group-aria-expanded:opacity-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
      <path d="M3 4h18v2H3V4zm0 7h12v2H3v-2zm0 7h18v2H3v-2z"></path>
    </svg>
    <svg class="absolute size-5 rotate-90 scale-[0.6] opacity-0 transition-[opacity,transform] duration-200 ease-[cubic-bezier(0.4,0,0.2,1)] group-aria-expanded:rotate-0 group-aria-expanded:scale-100 group-aria-expanded:opacity-100" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
      <path d="M18.3 5.71a1 1 0 0 0-1.41 0L12 10.59 7.11 5.7A1 1 0 0 0 5.7 7.11L10.59 12 5.7 16.89a1 1 0 1 0 1.41 1.41L12 13.41l4.89 4.89a1 1 0 0 0 1.41-1.41L13.41 12l4.89-4.89a1 1 0 0 0 0-1.4z"></path>
    </svg>
  </button>

  <div
    class={TOC_BACKDROP_CLASS}
    id={TOC_IDS.backdrop}
    aria-hidden="true"
  ></div>

  <!-- Убран излишний role="region", так как есть nav и parent aside -->
  <div class={TOC_PANEL_CLASS} id={TOC_IDS.panel}>
    <div class="flex min-h-12 items-center justify-between border-b border-border-light bg-[linear-gradient(135deg,var(--color-header-bg),var(--color-header-bg-end))] px-[0.85rem] text-text-inverse wide:rounded-t-lg">
      <h2 class="m-0 border-b-0 p-0 text-[0.8rem] font-bold uppercase tracking-[0.06em] leading-[3rem] text-overlay-inverse-88" id={TOC_IDS.heading}>{TOC_LABELS.title}</h2>
      <button class={closeButtonClass} id={TOC_IDS.close} aria-label={TOC_LABELS.close} type="button">
        <svg class="size-[18px]" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.3 5.71a1 1 0 0 0-1.41 0L12 10.59 7.11 5.7A1 1 0 0 0 5.7 7.11L10.59 12 5.7 16.89a1 1 0 1 0 1.41 1.41L12 13.41l4.89 4.89a1 1 0 0 0 1.41-1.41L13.41 12l4.89-4.89a1 1 0 0 0 0-1.4z"></path>
        </svg>
      </button>
    </div>

    <div class="h-[3px] overflow-hidden bg-border-light [html.dark-mode_&]:bg-overlay-inverse-08" aria-hidden="true">
      <div class="h-full w-0 bg-[linear-gradient(90deg,var(--color-header-bg),var(--color-header-bg-end))] transition-[width] duration-100 ease-linear" id={TOC_IDS.progress}></div>
    </div>

    <nav
      class={TOC_NAV_CLASS}
      id={TOC_IDS.nav}
      aria-label={TOC_LABELS.nav}
    >
      {tocHtml && <Fragment set:html={tocHtml} />}
    </nav>
  </div>
</aside>

<script>
  import { initTocPage } from "../model/page";

  initTocPage();
</script>
