---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";
import MarkdownDocPage from "../../shared/ui/MarkdownDocPage.astro";
import { buildEntryStaticPaths, getChangelogPath, getEntryBaseId } from "../../shared/lib/content-routes";

interface Props {
  entry: CollectionEntry<"changelogSections">;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getCollection("changelogSections");
  return buildEntryStaticPaths(entries, getEntryBaseId);
};

const { entry }: Props = Astro.props;
const { Content, headings } = await render(entry);
---

<MarkdownDocPage entry={entry} canonicalPath={getChangelogPath(entry)} headings={headings} toc="off">
  <Content />
</MarkdownDocPage>
