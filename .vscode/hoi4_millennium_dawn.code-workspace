{
	"extensions": {
		"recommendations": [
			"acarreiro.calculate",
			"adamprzybylski.paradox-syntax",
			"eamodio.gitlens",
			"editorconfig.editorconfig",
			"jasonnutter.vscode-codeowners",
			"shardulm94.trailing-spaces",
			"milleniumdawnmodteam.cwtools-md-edition",
			"tyriar.sort-lines",
			"wmaurer.change-case",
			"yzhang.markdown-all-in-one",
			"MilleniumDawnModTeam.hearts-of-iron-iv-utilities-2026",
			"hediet.vscode-drawio",
			"tomoki1207.pdf",
			"mechatroner.rainbow-csv",
			"janisdd.vscode-edit-csv",
			"vscode-icons-team.vscode-icons",
			"alefragnani.project-manager",
			"ms-python.python",
			"streetsidesoftware.code-spell-checker",
			"donjayamanne.githistory",
			"ms-vsliveshare.vsliveshare",
			"wayou.vscode-todo-highlight",
			"ms-vscode-remote.remote-wsl",
			"esbenp.prettier-vscode",
			"github.vscode-pull-request-github",
		]
	},
	"folders": [
		{
			"name": "Millennium-Dawn",
			"path": ".."
		}
	],
	"settings": {
		"editor.detectIndentation": false,
		"editor.insertSpaces": false,
		"editor.minimap.enabled": true,
		"editor.minimap.maxColumn": 80,
		"editor.renderControlCharacters": true,
		"editor.renderWhitespace": "boundary",
		"editor.rulers": [80, 120],
		"editor.tabSize": 4,
		// "editor.wordWrapColumn": 150,
		"files.associations": {
			"*.txt": "paradox"
		},
		"files.exclude": {
			"Millennium-Dawn/vscode-userdata:/": true,
		},
		"files.trimTrailingWhitespace": true,
		"gitlens.hovers.annotations.over": "annotation",
		"workbench.sideBar.location": "left",
		"workbench.colorTheme": "Dark Modern",
		"[yaml]": {
			"editor.tabSize": 1,
		},
		"[git-commit]": {
			"editor.rulers": [50, 72],
			"editor.wordWrapColumn": 72,
			"editor.wordWrap": "off"
		},
		"[paradox]": {
			"editor.defaultFormatter": "tboby.cwtools-vscode"
		},
		"hoi4ModUtilities.modFile": "/mnt/Linux/Millennium-Dawn/descriptor.mod",
		"hoi4ModUtilities.installPath": "C:\\Games\\Hearts of Iron IV\\",
		"search.exclude": {
			"localisation/braz_por": true,
			"localisation/spanish": true,
			"localisation/french": true,
			"localisation/russian": true,
			"localisation/korean": true,
			"localisation/german": true,
			"localisation/polish": true,
			"localisation/japanese": true,
			"localisation/simp_chinese": true
		},
		"cSpell.words": [
			"airzone",
			"Evangelion",
			"HACS",
			"Mechs",
			"Randallite",
			"Ranjets",
			"reqiore",
			"tanky",
			"transmutating"
		],
	}
}
