# Author(s): AngriestBird
guiTypes = {
	containerWindowType = {
		name = "ledger_open_container"
		position = { x=196 y= 97 }
		Orientation = UPPER_RIGHT
		origo = UPPER_RIGHT
		buttonType = {
			name = "ledger_open_btn"
			position = { x = 0 y = 0 }
			quadTextureSprite = "GFX_ledger_open_button"
			pdx_tooltip = "LEDGER_OPEN"
			pdx_tooltip_delayed = "LEDGER_OPEN_DESC"
			shortcut = "shift+4"
		}
	}

	# The Ledger Container
	containerWindowType = {
		name = "ledger_container"
		position = { x = 0 y = 0 }
		size = { width = 1224 height = 703 }
		clipping = no
		Orientation = center
		origo = center
		moveable = yes

		background = {
			name = "ledger_background"
			quadTextureSprite ="GFX_ledger_wide"
		}

		buttonType = {
			name = "close"
			position = {x=-40 y=22}
			spriteType = "GFX_closebutton"
			orientation = "UPPER_RIGHT"
			shortcut = "ESCAPE"
			clicksound = click_close
			pdx_tooltip = "CLOSE"
		}

		instantTextBoxType = {
			name = "ledger_title"
			position = { x = 390 y = 18 }

			font = "hoi_36header"
			borderSize = {x = 0 y = 0}
			text = "LEDGER_TITLE_SL"
			maxWidth = 450
			maxHeight = 20
			fixedsize = yes
			format = center

			Orientation = "UPPER_LEFT"
		}


		gridboxType = {
			name = "ledger_header_list"
			position = { x = 30 y = 86 }
			size = { width = 1194 height = 42 }
			slotsize = { width = 1194 height = 42 }
			format = "UPPER_LEFT"
			max_slots_horizontal = 1
		}

		gridboxType = {
			name = "ledger_tab_list"
			position = { x = 30 y = 66 }
			size = { width = 1194 height = 20 }
			slotsize = { width = 1194 height = 20 }
			format = "UPPER_LEFT"
			max_slots_horizontal = 1
		}

		containerWindowType = {
			name = "countries_info_list"
			position = { x=30 y = 128 }
			size = { width = 1194 height=524 }
			margin = { top = 8 bottom = 8 }
			verticalScrollbar = "right_vertical_slider"

			background = {
				name = "Background"
				quadTextureSprite ="GFX_tiled_window_transparent"
			}

			gridboxType = {
				name ="country_list"
				position = { x = 0 y = 0 }
				padding = { top = 50 bottom = 50 }
				size = { width = 100%% height = 100%% }
				slotsize = { width = 270 height = 25 }
				format = "UPPER_LEFT"
				#add_horizontal = no
				max_slots_horizontal = 1
			}
		}

		buttonType = {
			name = "next_page"
			position = { x=56 y =305}
			quadTextureSprite ="GFX_button_148x34"
			buttonText = "MUSICPLAYER_NEXT"
			buttonFont = "hoi_18b"
			Orientation = center
			clicksound = click_default
		}

		buttonType = {
			name = "previous_page"
			position = { x=-122 y =305}
