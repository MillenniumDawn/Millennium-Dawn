---
import { getEntry, render } from "astro:content";
import MarkdownDocPage from "../../shared/ui/MarkdownDocPage.astro";
import { CONTENT_PAGE_ROUTES } from "../../shared/config/page-meta";

const entry = await getEntry("pages", "faq");
if (!entry) {
  throw new Error("Missing pages/faq content entry");
}

const { Content, headings } = await render(entry);
---

<MarkdownDocPage entry={entry} canonicalPath={CONTENT_PAGE_ROUTES.faq} headings={headings}>
  <Content />
</MarkdownDocPage>
