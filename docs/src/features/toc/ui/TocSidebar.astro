---
import type { MarkdownHeading } from "astro";
import { TOC_IDS, TOC_LABELS } from "../lib/config";
import { renderTocHtml } from "../lib/render";
import { INVERSE_FOCUS_RING_CLASS } from "../../../shared/ui/tailwind";

interface Props {
  tocMode?: "auto" | "off";
  headings?: MarkdownHeading[];
}

const { tocMode = "auto", headings = [] }: Props = Astro.props;
const hidden = tocMode === "off";
const tocHtml = hidden ? "" : renderTocHtml(headings);

const toggleClass = [
  "fixed",
  "bottom-[calc(var(--space-xl)+60px)]",
  "left-lg",
  "z-toc-fab",
  "flex",
  "size-12",
  "items-center",
  "justify-center",
  "rounded-full",
  "bg-[linear-gradient(135deg,var(--color-header-bg),var(--color-header-bg-end))]",
  "text-text-inverse",
  "shadow-md",
  "transition-[background,transform,opacity]",
  "duration-200",
  "ease-[cubic-bezier(0.4,0,0.2,1)]",
  "hover:scale-[1.06]",
  "hover:bg-[linear-gradient(135deg,var(--color-header-bg-end),var(--color-header-bg))]",
  "active:scale-95",
  "wide:hidden",
  "[&[aria-expanded=true]>svg:first-of-type]:-rotate-90",
  "[&[aria-expanded=true]>svg:first-of-type]:scale-[0.6]",
  "[&[aria-expanded=true]>svg:first-of-type]:opacity-0",
  "[&[aria-expanded=true]>svg:last-of-type]:rotate-0",
  "[&[aria-expanded=true]>svg:last-of-type]:scale-100",
  "[&[aria-expanded=true]>svg:last-of-type]:opacity-100",
  INVERSE_FOCUS_RING_CLASS,
].join(" ");

const closeButtonClass = [
  "flex",
  "min-h-11",
  "min-w-11",
  "items-center",
  "justify-center",
  "rounded",
  "bg-transparent",
  "text-overlay-inverse-85",
  "transition-[color,background-color]",
  "duration-200",
  "ease-[cubic-bezier(0.4,0,0.2,1)]",
  "hover:bg-overlay-inverse-14",
  "hover:text-text-inverse",
  "wide:hidden",
  INVERSE_FOCUS_RING_CLASS,
].join(" ");
---

<aside class="toc-sidebar fixed left-0 top-0 z-toc h-screen w-0 pointer-events-none wide:relative wide:z-[1] wide:h-auto wide:w-[260px] wide:shrink-0 wide:pointer-events-auto print:hidden" id={TOC_IDS.sidebar} aria-labelledby={TOC_IDS.heading} hidden={hidden}>
  <button
    class={toggleClass}
    id={TOC_IDS.toggle}
    aria-label={TOC_LABELS.open}
    aria-expanded="false"
    aria-controls={TOC_IDS.panel}
    type="button"
  >
    <svg class="absolute size-5 transition-[opacity,transform] duration-200 ease-[cubic-bezier(0.4,0,0.2,1)]" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
      <path d="M3 4h18v2H3V4zm0 7h12v2H3v-2zm0 7h18v2H3v-2z"></path>
    </svg>
    <svg class="absolute size-5 rotate-90 scale-[0.6] opacity-0 transition-[opacity,transform] duration-200 ease-[cubic-bezier(0.4,0,0.2,1)]" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
      <path d="M18.3 5.71a1 1 0 0 0-1.41 0L12 10.59 7.11 5.7A1 1 0 0 0 5.7 7.11L10.59 12 5.7 16.89a1 1 0 1 0 1.41 1.41L12 13.41l4.89 4.89a1 1 0 0 0 1.41-1.41L13.41 12l4.89-4.89a1 1 0 0 0 0-1.4z"></path>
    </svg>
  </button>

  <div
    class="fixed inset-x-0 bottom-0 top-[var(--header-height)] z-toc-fab bg-overlay-scrim-45 opacity-0 pointer-events-none transition-opacity duration-toc ease-[cubic-bezier(0.4,0,0.2,1)] [.toc-sidebar.is-open_&]:pointer-events-auto [.toc-sidebar.is-open_&]:opacity-100 [html.dark-mode_&]:bg-overlay-scrim-60 wide:hidden"
    id={TOC_IDS.backdrop}
    aria-hidden="true"
  ></div>

  <div
    class="fixed left-0 top-[var(--header-height)] z-toc-panel flex h-[calc(100dvh-var(--header-height))] w-[260px] translate-x-[-100%] flex-col border-r border-border-light bg-surface transition-[transform,box-shadow] duration-toc ease-[cubic-bezier(0.4,0,0.2,1)] [.toc-sidebar.is-open_&]:translate-x-0 [.toc-sidebar.is-open_&]:shadow-lg wide:sticky wide:top-[calc(var(--header-height)+1rem)] wide:h-[calc(100vh-var(--header-height)-1rem)] wide:w-full wide:translate-x-0 wide:rounded-t-lg wide:shadow-none"
    id={TOC_IDS.panel}
    role="region"
    aria-labelledby={TOC_IDS.heading}
  >
    <div class="flex min-h-12 items-center justify-between border-b border-border-light bg-[linear-gradient(135deg,var(--color-header-bg),var(--color-header-bg-end))] px-[0.85rem] text-text-inverse wide:rounded-t-lg">
      <h2 class="m-0 border-b-0 p-0 text-[0.8rem] font-bold uppercase tracking-[0.06em] leading-[3rem] text-overlay-inverse-88" id={TOC_IDS.heading}>{TOC_LABELS.title}</h2>
      <button class={closeButtonClass} id={TOC_IDS.close} aria-label={TOC_LABELS.close} type="button">
        <svg class="size-[18px]" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.3 5.71a1 1 0 0 0-1.41 0L12 10.59 7.11 5.7A1 1 0 0 0 5.7 7.11L10.59 12 5.7 16.89a1 1 0 1 0 1.41 1.41L12 13.41l4.89 4.89a1 1 0 0 0 1.41-1.41L13.41 12l4.89-4.89a1 1 0 0 0 0-1.4z"></path>
        </svg>
      </button>
    </div>

    <div class="h-[3px] overflow-hidden bg-border-light [html.dark-mode_&]:bg-overlay-inverse-08" aria-hidden="true">
      <div class="h-full w-0 bg-[linear-gradient(90deg,var(--color-header-bg),var(--color-header-bg-end))] transition-[width] duration-100 ease-linear" id={TOC_IDS.progress}></div>
    </div>

    <nav
      class="flex-1 overflow-x-hidden overflow-y-auto py-sm [scrollbar-color:var(--color-border)_transparent] [scrollbar-width:thin] motion-reduce:scroll-auto [&::-webkit-scrollbar]:w-1 [&::-webkit-scrollbar-thumb]:rounded [&::-webkit-scrollbar-thumb]:bg-border [&::-webkit-scrollbar-track]:bg-transparent"
      id={TOC_IDS.nav}
      aria-label={TOC_LABELS.nav}
    >
      {tocHtml && <Fragment set:html={tocHtml} />}
    </nav>
  </div>
</aside>

<script>
  import { initTocPage } from "../model/page";

  initTocPage();
</script>
