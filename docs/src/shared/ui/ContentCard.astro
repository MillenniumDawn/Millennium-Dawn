---
import {
  CONTENT_CARD_CLASS,
  CONTENT_CARD_DESCRIPTION_CLASS,
  CONTENT_CARD_KIND_CLASS,
  CONTENT_CARD_META_CLASS,
  CONTENT_CARD_TITLE_CLASS,
  CONTENT_CARD_TITLE_LINK_CLASS,
} from "./tailwind";

interface Props {
  title: string;
  url?: string;
  kind?: string;
  description?: string;
  meta?: string;
}

const { title, url, kind, description, meta }: Props = Astro.props;
---

<div class={CONTENT_CARD_CLASS}>
  {kind && <p class={CONTENT_CARD_KIND_CLASS}>{kind}</p>}

  <h3 class={CONTENT_CARD_TITLE_CLASS}>
    {url ? <a class={CONTENT_CARD_TITLE_LINK_CLASS} href={url}>{title}</a> : <span>{title}</span>}
  </h3>

  {description && <p class={CONTENT_CARD_DESCRIPTION_CLASS}>{description}</p>}
  {meta && <p class={CONTENT_CARD_META_CLASS}>{meta}</p>}
</div>
