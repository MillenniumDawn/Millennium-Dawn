			format = centre
			font = "hoi_14b"
		}

		# ══════════════════ MILITARY STANCE PANELS ══════════════════════
		# Three side-by-side panels, 200px wide, 8px gutters, starting x=20.
		# NOTE: no decorative panel background is included here — the
		# earlier version referenced invented GFX sprite names
		# (GFX_generic_panel_bg) that don't exist in any asset file,
		# which will hard-fail interface loading. Add a real background
		# iconType once you have actual panel art; the layout below works
		# fine without one in the meantime.

		#  Tier I — Low Intensity 
		textBoxType = {
			name = "stance_tier1_header"
