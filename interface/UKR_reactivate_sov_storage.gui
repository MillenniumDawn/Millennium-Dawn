guiTypes = {
	# Storage list in the "Soviet Equipment in Storage" decision category (UKR_reactivate_sov_storage_gui).
	# Fixed height: ten section headers plus six equipment rows (16 rows of 28).
	containerWindowType = {
		name = "UKR_reactivate_sov_storage_window"
		position = { x = 5 y = 0 }
		size = { width = 500 height = 496 }

		background = {
			name = "Background"
			quadTextureSprite = "GFX_tiled_window_transparent"
		}

		instantTextBoxType = {
			name = "UKR_storage_title"
			position = { x = 0 y = 8 }
			font = "hoi_20b"
			text = "UKR_storage_title"
			format = center
			maxWidth = 500
			maxHeight = 24
		}

		gridboxType = {
			name = "UKR_storage_grid"
			position = { x = 10 y = 38 }
			size = { width = 480 height = 448 }
			slotsize = { width = 480 height = 28 }
			format = "UPPER_LEFT"
			max_slots_horizontal = 1
		}
	}

