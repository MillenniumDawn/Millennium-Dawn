---
import ContentCard from "@/shared/ui/ContentCard.astro";
import type { CardItem } from "@/shared/lib/cards";
import { slugifyText } from "@/shared/lib/slugs";
import {
  BUTTON_SECONDARY_CLASS,
  CONTENT_GRID_CLASS,
  MUTED_TEXT_CLASS,
  SEARCH_INDEX_INPUT_CLASS,
  SEARCH_INDEX_LABEL_CLASS,
  SEARCH_INDEX_PAGINATION_CLASS,
  SEARCH_INDEX_ROOT_CLASS,
  SEARCH_INDEX_STATUS_CLASS,
} from "@/shared/ui/tailwind";

interface Props {
  items: CardItem[];
  ariaLabel?: string;
  pageSize?: number;
  filterLabel?: string;
  filterPlaceholder?: string;
  emptyText?: string;
  indexClass?: string;
}

const {
  items,
  ariaLabel,
  pageSize = 8,
  filterLabel = "Search",
  filterPlaceholder = "Type to filter...",
  emptyText = "No results matched your search.",
  indexClass = "",
}: Props = Astro.props;

const filterSeed = slugifyText(ariaLabel ?? indexClass ?? "search-index") || "search-index";
const filterId = `${filterSeed}-filter`;
---

<section class:list={[SEARCH_INDEX_ROOT_CLASS, indexClass]} data-card-index data-page-size={pageSize} aria-labelledby="search-heading">
  <h2 id="search-heading" class="sr-only">{ariaLabel ?? filterLabel}</h2>
  <label class={SEARCH_INDEX_LABEL_CLASS} for={filterId}>
    {filterLabel}
  </label>
  <input
    id={filterId}
    class={SEARCH_INDEX_INPUT_CLASS}
    type="search"
    placeholder={filterPlaceholder}
    autocomplete="off"
    data-card-filter
  />

  <div class={CONTENT_GRID_CLASS} data-card-list aria-live="polite">
    {
      items.map((item) => (
        <div class="min-w-0 flex w-full h-full" data-card-item data-search={item.searchBlob}>
          <ContentCard
            title={item.title}
            url={item.url}
            kind={item.kind}
            description={item.description}
            meta={item.meta}
          />
        </div>
      ))
    }
  </div>

  <p class={MUTED_TEXT_CLASS} data-card-empty hidden>
    {emptyText}
  </p>

  <nav class={SEARCH_INDEX_PAGINATION_CLASS} aria-label="Pagination">
    <button type="button" class={BUTTON_SECONDARY_CLASS} data-card-prev>
      Previous
    </button>
    <span class={SEARCH_INDEX_STATUS_CLASS} data-card-status aria-live="polite"></span>
    <button type="button" class={BUTTON_SECONDARY_CLASS} data-card-next>
      Next
    </button>
  </nav>
</section>

<script>
  import { initCardIndexPage } from "../model/page";

  initCardIndexPage();
</script>
