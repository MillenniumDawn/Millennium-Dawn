# Line endings and charset only. Indentation and whitespace trimming are left
# alone here — the pre-commit hooks own those, and gfx/, map/ and interface/
# carry significant alignment the fixers deliberately skip.

root = true

[*]
end_of_line = lf
charset = utf-8

# HOI4 requires the BOM on localisation files
[localisation/**.yml]
charset = utf-8-bom

# Map CSVs are the one format the game wants with CRLF
[*.csv]
end_of_line = crlf
