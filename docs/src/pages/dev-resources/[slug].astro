---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";
import MarkdownDocPage from "../../shared/ui/MarkdownDocPage.astro";
import { buildEntryStaticPaths, getEntryBaseId, getResourcePath } from "../../shared/lib/content-routes";

interface Props {
  entry: CollectionEntry<"resources">;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getCollection("resources");
  return buildEntryStaticPaths(entries, getEntryBaseId);
};

const { entry }: Props = Astro.props;
const { Content, headings } = await render(entry);
---

<MarkdownDocPage entry={entry} canonicalPath={getResourcePath(entry)} headings={headings}>
  <Content />
</MarkdownDocPage>
