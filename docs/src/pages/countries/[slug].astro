---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";
import CountryLayout from "../../layouts/CountryLayout.astro";
import { stripMarkdownExt } from "../../lib/slugs";

interface Props {
  entry: CollectionEntry<"countries">;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getCollection("countries");
  return entries.map((entry) => ({
    params: { slug: entry.data.slug ?? stripMarkdownExt(entry.id) },
    props: { entry },
  }));
};

const { entry }: Props = Astro.props;
const { Content, headings } = await render(entry);
const countrySlug = entry.data.slug ?? stripMarkdownExt(entry.id);
---

<CountryLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={`/countries/${countrySlug}/`}
  pageId={entry.data.page_id ?? stripMarkdownExt(entry.id)}
  flagImage={entry.data.flag_image}
  infobox={entry.data.infobox ?? []}
  headings={headings}
>
  <Content />
</CountryLayout>
