guiTypes = {
	containerWindowType = {
		name = "md_prod_graph_container"
		position = { x = 0 y = 0 }
		size = { width = 1024 height = 703 }
		Orientation = center
		origo = center
		moveable = yes

		background = {
			name = "gdp_graph_background"
			quadTextureSprite = "GFX_ledger"
		}

		instantTextBoxType = {
			name = "gdp_graph_title"
			position = { x = 290 y = 18 }
			font = "hoi_36header"
			text = "PRODUCTIVITY GRAPH"
			maxWidth = 450
			maxHeight = 20
			fixedsize = yes
			format = center
		}

		instantTextBoxType = {
			name = "gdp_current_gdp_TITLE"
			position = { x = 120 y = 82 }
			font = "hoi_20bs"
			format = left
			maxWidth = 340
			maxHeight = 24
			fixedsize = yes
			text = "Our current average productivity is [?overall_productivity|2]" 
		}

		instantTextBoxType = {
			name = "gdp_yoy_change_TITLE"
			position = { x = 120 y = 98 } 
			font = "hoi_20bs"
			format = left
			maxWidth = 340
			maxHeight = 24
			fixedsize = yes
			text = "YoY Change: [?md_yoy_prod_change_absolute|+2] ([?md_yoy_prod_change|+2]%)" 
		}

		instantTextBoxType = {
			name = "gdp_econ_cycle_TITLE"
			position = { x = 120 y = 114 } 
			font = "hoi_20bs"
			format = left
			maxWidth = 340
			maxHeight = 24
			fixedsize = yes
			text = "Economic Status: [GetMDSubmodEconCycle]"
		}

		gridboxtype = {
			name = "md_line_segments_prod"
			position = { x = -395 y = 495 } 
			size = { width = 1024 height = 590 }
