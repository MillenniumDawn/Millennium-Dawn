	# === Songun Naval Doctrine — buildup window ===
	# Bound via NKO_Navy_projects decision category scripted_gui.
	# Header + 4 track rows; each row has a label, progress text and 4 tier
	# marker icons that become visible as NKO_<track>_progress crosses tier
	# thresholds (25 / 50 / 75 / 100). Sprites alias existing focus icons
	# defined in interface/MD_NKO_interface.gfx.

	containerWindowType = {
		name = "NKO_naval_buildup_window"
