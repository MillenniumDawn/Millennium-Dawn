	# interface/md_submod_gdp_graph.gui

	guiTypes = {
		containerWindowType = {
			name = "md_submod_open_button_container"
			position = { x = 196 y = 13 } 
			Orientation = UPPER_RIGHT
			origo = UPPER_RIGHT

		buttonType = {
			name = "md_flax_open_button"
			position = { x = 0 y = 0 }
			quadTextureSprite = "GFX_ledger_open_button"
			pdx_tooltip = "md_graph_plus_open_tt"
			shortcut = "shift+6"
		}
	}

	containerWindowType = {
		name = "md_gdp_graph_container"
		position = { x = 0 y = 0 }
		size = { width = 1024 height = 703 }
		Orientation = center
		origo = center
		moveable = yes

		background = {
			name = "gdp_graph_background"
			quadTextureSprite = "GFX_ledger"
		}

		instantTextBoxType = {
			name = "gdp_graph_title"
			position = { x = 290 y = 18 }
			font = "hoi_36header"
			text = "GDP GRAPH"
			maxWidth = 450
			maxHeight = 20
			fixedsize = yes
			format = center
		}

		instantTextBoxType = {
			name = "gdp_current_gdp_TITLE"
			position = { x = 120 y = 82 }
			font = "hoi_20bs"
			format = left
			maxWidth = 340
			maxHeight = 24
			fixedsize = yes
			text = "Our current GDP is $[?gdp_total|3]B" 
		}

		instantTextBoxType = {
			name = "gdp_yoy_change_TITLE"
			position = { x = 120 y = 98 } # Placed right below the current GDP
			font = "hoi_20bs"
			format = left
			maxWidth = 340
			maxHeight = 24
			fixedsize = yes
			# The |+2 formats it beautifully like: +4.50% or -2.10%
			text = "YoY Change: $[?md_yoy_gdp_change_billions|+2] ([?md_yoy_gdp_change|+2]%)" 
		}

		instantTextBoxType = {
			name = "gdp_econ_cycle_TITLE"
			position = { x = 120 y = 114 } # Placed perfectly below the YoY text
			font = "hoi_20bs"
			format = left
			maxWidth = 340
			maxHeight = 24
			fixedsize = yes
			# Calls the Scripted Loc we made in step 1!
			text = "Economic Status: [GetMDSubmodEconCycle]"
		}

		gridboxtype = {
			name = "md_line_segments"
			position = { x = -395 y = 495 } 
			size = { width = 1024 height = 590 }
			slotsize = { width = 7 height = 200 } 
			max_slots_horizontal = 120 
			add_horizontal = yes
		}        # TAB BUTTONS (Row 1: Macroeconomics)
		buttonType = {
			name = "open_gdp_graph"
			position = { x = 515 y = 65 }
			quadTextureSprite = "GFX_small_button_71x26"
			buttonFont = "hoi_16mbs"
