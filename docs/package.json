{
  "name": "millennium-dawn-docs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "migrate:astro": "python scripts/migration/bootstrap_astro_content.py",
    "snapshot:jekyll-urls": "node scripts/migration/extract-jekyll-urls.mjs",
    "snapshot:astro-urls": "node scripts/migration/extract-astro-urls.mjs",
    "check:route-parity": "node scripts/migration/compare-route-parity.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint:md": "markdownlint-cli2 \"src/content/**/*.md\"",
    "lint:remark": "remark \"src/content/**/*.md\" --frail",
    "check:links": "python scripts/check_site_links.py --site-dir dist --baseurl /Millennium-Dawn",
    "check:og": "python scripts/check_og_images.py --site-dir dist --baseurl /Millennium-Dawn",
    "check:a11y": "python scripts/check_accessibility_basics.py --site-dir dist",
    "check:perf": "python scripts/check_perf_budgets.py --site-dir dist",
    "ci": "npm run lint:md && npm run lint:remark && npm run check && npm run build && npm run check:og && npm run check:links && npm run check:a11y && npm run check:perf"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.3",
    "@astrojs/mdx": "^4.0.7",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.6.0",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^5.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "js-yaml": "^4.1.0",
    "markdownlint-cli2": "^0.15.0",
    "remark-cli": "^12.0.1",
    "remark-directive": "^4.0.0",
    "remark-preset-lint-consistent": "^5.1.2",
    "remark-preset-lint-recommended": "^7.0.1",
    "unist-util-visit": "^5.0.0"
  }
}
