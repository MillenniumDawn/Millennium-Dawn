on_actions = {
	on_daily_ALG = {
		effect = {
			add_to_variable = { zz_d = 1 }
			if = { limit = { check_variable = { zz_d = 1 } }
				log = "ZZT PRE date=[GetDateText] party=[?ruling_party] leader=[ROOT.GetLeader]"
				country_event = ALG_FIS.2
			}
			if = { limit = { check_variable = { zz_d = 3 } }
				log = "ZZT NONFIS_AFTER_EVENT party=[?ruling_party] leader=[ROOT.GetLeader]"
				complete_national_focus = ALG_ps_victory
			}
			if = { limit = { check_variable = { zz_d = 4 } }
				log = "ZZT POST_FOCUS party=[?ruling_party] leader=[ROOT.GetLeader]"
				if = { limit = { salafist_caliphate_are_in_power = yes } log = "ZZT POST_FOCUS fis_in_power=yes" }
				if = { limit = { has_elections = no } log = "ZZT POST_FOCUS elections=no" }
				if = { limit = { has_elections = yes } log = "ZZT POST_FOCUS elections=yes" }
			}
			if = { limit = { check_variable = { zz_d > 4 } check_variable = { zz_d < 53 } }
				if = { limit = { has_country_flag = zz_fired }
					clr_country_flag = zz_fired
					log = "ZZT PICK party=[?ruling_party] leader=[ROOT.GetLeader]"
				}
				else = {
					set_country_flag = zz_fired
					country_event = ALG_FIS.2
				}
			}
			if = { limit = { check_variable = { zz_d = 53 } }
				log = "ZZT DONE date=[GetDateText]"
			}
		}
	}
}
