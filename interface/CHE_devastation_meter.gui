			size = { width = 300 height = 18 }
			format = left
			font = "hoi_16"
		}
		textBoxType = {
			name = "devastation_drift_text"
			text = "DEVASTATION_DRIFT_READOUT" # "Weekly Drift: +[?devastation_weekly_drift]%"
			position = { x = 320 y = 136 }
			size = { width = 300 height = 18 }
			format = left
			font = "hoi_16"
		}

		#  Currently-active stance readout, above the panels 
		textBoxType = {
			name = "chechnya_active_stance_text"
			text = "[chechnya_stance_status]"
			position = { x = 50%% y = 164 }
