guiTypes = {
	containerWindowType = {
		name = "show_devastation_meter"
		position = { x = 0 y = 5%% }
		size = { width = 640 height = 440 }
		clipping = no
		moveable = no

		#  Title 
		

		instantTextBoxType = {
			name = "devastation_subtitle_text"
			text = "DEVASTATION_METER_SUBTITLE" # "DEVASTATION LEVEL"
			position = { x = 0 y = 26 }
			size = { width = 600 height = 400 }
			format = centre
			font = "hoi_14"
		}

		#  The bar itself, with a dynamic hover tooltip 
		iconType = {
			name = "devastation_bar"
			spriteType = "GFX_devastation_damage"
			position = { x = 20 y = 52 }
			pdx_tooltip = "[devastation_tooltip]"
		}

		#  Current level, prominently highlighted 
		instantTextBoxType = {
			name = "devastation_current_level_text"
			text = "[devastation_level_label]"
			position = { x = 50%% y = 108 }
			size = { width = 300 height = 24 }
			format = centre
			font = "hoi_18b"
		}

		#  Numeric readouts 
		instantTextBoxType = {
			name = "devastation_percentage_text"
			text = "devastation_percentage_READOUT" # "Current Devastation: [?devastation_percentage]%"
			position = { x = 20 y = 136 }
			size = { width = 300 height = 18 }
			format = left
			font = "hoi_16"
		}
		instantTextBoxType = {
			name = "devastation_drift_text"
			text = "DEVASTATION_DRIFT_READOUT" # "Weekly Drift: +[?devastation_weekly_drift]%"
			position = { x = 320 y = 136 }
			size = { width = 300 height = 18 }
			format = left
			font = "hoi_16"
		}
	}
}
