# interface/md_submod_debt_graph.gui

guiTypes = {
	containerWindowType = {
		name = "md_debt_graph_container"
		position = { x = 0 y = 0 }
		size = { width = 1024 height = 703 }
		Orientation = center
		origo = center
		moveable = yes

		background = {
			name = "gdp_graph_background"
			quadTextureSprite = "GFX_ledger"
		}

		instantTextBoxType = {
			name = "debt_graph_title"
			position = { x = 290 y = 18 }
			font = "hoi_36header"
			text = "DEBT GRAPH"
			maxWidth = 450
			maxHeight = 20
			fixedsize = yes
			format = center
		}

		instantTextBoxType = {
			name = "debt_current_debt_TITLE"
			position = { x = 120 y = 82 }
			font = "hoi_20bs"
			format = left
			maxWidth = 340
			maxHeight = 24
			fixedsize = yes
			text = "Our current Debt is $[?debt|3]B" 
		}

		instantTextBoxType = {
			name = "debt_yoy_change_TITLE"
			position = { x = 120 y = 98 }
			font = "hoi_20bs"
			format = left
			maxWidth = 340
			maxHeight = 24
			fixedsize = yes
			text = "YoY Change: $[?md_yoy_debt_change_billions|-2]B ([?md_yoy_debt_change|-2]%)" 
		}

		instantTextBoxType = {
			name = "debt_interest_rate_TITLE"
			position = { x = 120 y = 114 } # Placed perfectly below the YoY text
			font = "hoi_20bs"
			format = left
			maxWidth = 340
			maxHeight = 24
			fixedsize = yes
			text = "Interest Rate: [?interest_rate|2]%" 
		}

		gridboxtype = {
			name = "md_line_segments_debt"
			position = { x = -395 y = 495 } 
			size = { width = 1024 height = 590 }
			slotsize = { width = 7 height = 200 } 
			max_slots_horizontal = 120 
			add_horizontal = yes
		}        # TAB BUTTONS (Row 1: Macroeconomics)
		buttonType = {
			name = "open_gdp_graph"
			position = { x = 515 y = 65 }
			quadTextureSprite = "GFX_small_button_71x26"
			buttonFont = "hoi_16mbs"
			buttonText = "MD_GRAPH_BTN_GDP"
			pdx_tooltip = "gdp_subgraph_open"
		}
		buttonType = {
			name = "open_gdpc_graph"
			position = { x = 590 y = 65 }
			quadTextureSprite = "GFX_small_button_71x26"
			buttonFont = "hoi_16mbs"
			buttonText = "MD_GRAPH_BTN_GDPC"
			pdx_tooltip = "gdpc_subgraph_open"
		}
		buttonType = {
			name = "open_prod_graph"
			position = { x = 665 y = 65 }
			quadTextureSprite = "GFX_small_button_71x26"
			buttonFont = "hoi_16mbs"
			buttonText = "MD_GRAPH_BTN_PROD"
			pdx_tooltip = "prod_subgraph_open"
		}
		buttonType = {
			name = "open_debt_graph"
			position = { x = 740 y = 65 }
			quadTextureSprite = "GFX_small_button_71x26"
			buttonFont = "hoi_16mbs"
			buttonText = "MD_GRAPH_BTN_DEBT"
			pdx_tooltip = "debt_subgraph_open"
		}
		buttonType = {
			name = "open_inflation_graph"
			position = { x = 815 y = 65 }
			quadTextureSprite = "GFX_small_button_71x26"
			buttonFont = "hoi_16mbs"
			buttonText = "MD_GRAPH_BTN_INFL"
			pdx_tooltip = "inflation_subgraph_open"
		}

		# TAB BUTTONS (Row 2: Sectors & Grid)
		buttonType = {
			name = "open_pop_graph"
			position = { x = 515 y = 95 }
			quadTextureSprite = "GFX_small_button_71x26"
			buttonFont = "hoi_16mbs"
			buttonText = "MD_GRAPH_BTN_POP"
			pdx_tooltip = "pop_subgraph_open"
		}
		buttonType = {
			name = "open_budget_graph"
			position = { x = 590 y = 95 }
			quadTextureSprite = "GFX_small_button_71x26"
			buttonFont = "hoi_16mbs"
			buttonText = "MD_GRAPH_BTN_BUDGET"
			pdx_tooltip = "budget_subgraph_open"
		}
		buttonType = {
			name = "open_energy_graph"
			position = { x = 665 y = 95 }
			quadTextureSprite = "GFX_small_button_71x26"
			buttonFont = "hoi_16mbs"
			buttonText = "MD_GRAPH_BTN_ENERGY"
			pdx_tooltip = "energy_subgraph_open"
		}
		buttonType = {
			name = "open_defense_graph"
			position = { x = 740 y = 95 }
			quadTextureSprite = "GFX_small_button_71x26"
			buttonFont = "hoi_16mbs"
			buttonText = "MD_GRAPH_BTN_DEFENSE"
			pdx_tooltip = "defense_subgraph_open"
		}
		buttonType = {
			name = "open_trade_graph"
			position = { x = 815 y = 95 }
			quadTextureSprite = "GFX_small_button_71x26"
			buttonFont = "hoi_16mbs"
			buttonText = "MD_GRAPH_BTN_TRADE"
			pdx_tooltip = "trade_subgraph_open"
		}



		# Y-AXIS LABELS (Note it uses md_debt_y_axis_label now)
		instantTextboxType = { name = "y_axis_10" position = { x = 20 y = 140 } font = "hoi_20bs" text = "$[?md_debt_y_axis_label^10|0Y]" maxWidth = 70 format = right }
		instantTextboxType = { name = "y_axis_9" position = { x = 20 y = 185 } font = "hoi_20bs" text = "$[?md_debt_y_axis_label^9|0Y]" maxWidth = 70 format = right }
		instantTextboxType = { name = "y_axis_8" position = { x = 20 y = 230 } font = "hoi_20bs" text = "$[?md_debt_y_axis_label^8|0Y]" maxWidth = 70 format = right }
		instantTextboxType = { name = "y_axis_7" position = { x = 20 y = 275 } font = "hoi_20bs" text = "$[?md_debt_y_axis_label^7|0Y]" maxWidth = 70 format = right }
		instantTextboxType = { name = "y_axis_6" position = { x = 20 y = 320 } font = "hoi_20bs" text = "$[?md_debt_y_axis_label^6|0Y]" maxWidth = 70 format = right }
		instantTextboxType = { name = "y_axis_5" position = { x = 20 y = 365 } font = "hoi_20bs" text = "$[?md_debt_y_axis_label^5|0Y]" maxWidth = 70 format = right }
		instantTextboxType = { name = "y_axis_4" position = { x = 20 y = 410 } font = "hoi_20bs" text = "$[?md_debt_y_axis_label^4|0Y]" maxWidth = 70 format = right }
		instantTextboxType = { name = "y_axis_3" position = { x = 20 y = 455 } font = "hoi_20bs" text = "$[?md_debt_y_axis_label^3|0Y]" maxWidth = 70 format = right }
		instantTextboxType = { name = "y_axis_2" position = { x = 20 y = 500 } font = "hoi_20bs" text = "$[?md_debt_y_axis_label^2|0Y]" maxWidth = 70 format = right }
		instantTextboxType = { name = "y_axis_1" position = { x = 20 y = 545 } font = "hoi_20bs" text = "$[?md_debt_y_axis_label^1|0Y]" maxWidth = 70 format = right }
		instantTextboxType = { name = "y_axis_0" position = { x = 20 y = 590 } font = "hoi_20bs" text = "$[?md_debt_y_axis_label^0|0Y]" maxWidth = 70 format = right }

		instantTextBoxType = { name = "x_axis_0" position = { x = 90 y = 654 } font = "hoi_20bs" text = "[?date_scale^0]" maxWidth = 50 }
		instantTextBoxType = { name = "x_axis_1" position = { x = 174 y = 654 } font = "hoi_20bs" text = "[?date_scale^1]" maxWidth = 50 }
		instantTextBoxType = { name = "x_axis_2" position = { x = 258 y = 654 } font = "hoi_20bs" text = "[?date_scale^2]" maxWidth = 50 }
		instantTextBoxType = { name = "x_axis_3" position = { x = 342 y = 654 } font = "hoi_20bs" text = "[?date_scale^3]" maxWidth = 50 }
		instantTextBoxType = { name = "x_axis_4" position = { x = 426 y = 654 } font = "hoi_20bs" text = "[?date_scale^4]" maxWidth = 50 }
		instantTextBoxType = { name = "x_axis_5" position = { x = 510 y = 654 } font = "hoi_20bs" text = "[?date_scale^5]" maxWidth = 50 }
		instantTextBoxType = { name = "x_axis_6" position = { x = 594 y = 654 } font = "hoi_20bs" text = "[?date_scale^6]" maxWidth = 50 }
		instantTextBoxType = { name = "x_axis_7" position = { x = 678 y = 654 } font = "hoi_20bs" text = "[?date_scale^7]" maxWidth = 50 }
		instantTextBoxType = { name = "x_axis_8" position = { x = 762 y = 654 } font = "hoi_20bs" text = "[?date_scale^8]" maxWidth = 50 }
		instantTextBoxType = { name = "x_axis_9" position = { x = 846 y = 654 } font = "hoi_20bs" text = "[?date_scale^9]" maxWidth = 50 }
		instantTextBoxType = { name = "x_axis_10" position = { x = 930 y = 654 } font = "hoi_20bs" text = "[?date_scale^10]" maxWidth = 50 }

		buttonType = {
			name = "close_gdp_screen"
			position = { x = -40 y = 22 }
			spriteType = "GFX_closebutton"
			orientation = "UPPER_RIGHT"
			shortcut = "ESCAPE"
		}
	}
}