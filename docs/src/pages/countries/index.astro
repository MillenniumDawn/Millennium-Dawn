---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { cssUrl, withBase } from "../../lib/urls";
import {
  getCountryPath,
  getEntryBodyClass,
  getEntryPageId,
} from "../../lib/content-routes";
import { BODY_TEXT_CLASS, INHERIT_LINK_CLASS, PAGE_TITLE_CLASS, SECTION_TITLE_CLASS } from "../../shared/ui/tailwind";

const focusCountries = (await getCollection("countries"))
  .filter((country) => country.data.unique_focus_tree)
  .slice()
  .sort((a, b) => (a.data.grid_order ?? 0) - (b.data.grid_order ?? 0));

const pageEntry = await getEntry("pages", "countries");
if (!pageEntry) {
  throw new Error("Missing pages/countries content entry");
}
const { Content: PageContent } = await render(pageEntry);
const canonicalPath = pageEntry.data.permalink ?? "/countries/";

const countryCardLinkClass = [INHERIT_LINK_CLASS, "hover:text-primary", "hover:no-underline"].join(" ");
---

<BaseLayout
  title={pageEntry.data.title}
  pageId={getEntryPageId(pageEntry)}
  description={pageEntry.data.description}
  canonicalPath={canonicalPath}
  seo={pageEntry.data.seo ?? true}
  robots={pageEntry.data.robots}
  bodyClass={getEntryBodyClass(pageEntry)}
  toc="off"
>
  <h1 class={PAGE_TITLE_CLASS}>Countries</h1>
  <p class={BODY_TEXT_CLASS}>The following countries are playable in Millennium Dawn: Modern Day Mod.</p>

  <h2 class={SECTION_TITLE_CLASS}>Unique Focus Trees</h2>
  <div class="mb-xl mt-md grid gap-md [grid-template-columns:repeat(auto-fill,minmax(220px,1fr))]" role="list" aria-label="Countries with unique focus trees">
    {focusCountries.map((country) => (
      <article
        class="relative isolate grid min-h-[104px] gap-[0.25rem] overflow-hidden rounded-lg border border-border-light bg-surface p-md shadow-sm transition-[transform,box-shadow,border-color] duration-[var(--transition-speed)] ease-[var(--transition-fn)] hover:-translate-y-0.5 hover:border-border hover:shadow-md before:absolute before:inset-0 before:-z-[1] before:bg-[linear-gradient(180deg,var(--color-focus-card-grad-1)_0%,var(--color-focus-card-grad-2)_42%,var(--color-focus-card-grad-3)_72%,var(--color-focus-card-grad-4)_100%)]"
        role="listitem"
        style={country.data.flag_image ? `--country-flag-image: ${cssUrl(country.data.flag_image)};` : undefined}
      >
        {country.data.flag_image && (
          <span
            class="pointer-events-none absolute inset-0 -z-[2] opacity-[0.28] [background-image:linear-gradient(135deg,var(--color-surface-muted-overlay)_0%,transparent_40%),var(--country-flag-image)] [background-position:center,center] [background-repeat:no-repeat,no-repeat] [background-size:cover,cover] [mask-image:linear-gradient(180deg,var(--color-mask-solid)_0%,var(--color-mask-mid)_48%,var(--color-mask-mid-38)_72%,var(--color-mask-fade)_100%)] [html.dark-mode_&]:opacity-40"
            aria-hidden="true"
          ></span>
        )}
        <p class="m-0 text-[1.05rem] font-semibold leading-[1.35] text-text">
          <a class={countryCardLinkClass} href={withBase(getCountryPath(country))}>{country.data.title}</a>
        </p>
        {country.data.grid_note && <p class="m-0 text-[0.86rem] leading-[1.55] text-text-secondary">{country.data.grid_note}</p>}
      </article>
    ))}
  </div>

  <PageContent />
</BaseLayout>
