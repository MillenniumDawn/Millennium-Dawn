---
import { withBase } from "../lib/urls";
import { BASE_LINK_CLASS, LIST_CLASS, LIST_ITEM_CLASS, MINOR_HEADING_CLASS, PANEL_SURFACE_CLASS } from "../shared/ui/tailwind";

interface ResourceItem {
  title: string;
  url: string;
}

interface ResourceGroup {
  heading: string;
  items: ResourceItem[];
}

interface Props {
  groups: ResourceGroup[];
}

const { groups }: Props = Astro.props;

function resolveGroupHref(url: string): string {
  return url.includes("://") ? url : withBase(url);
}
---

{groups.map((group) => (
  <section class:list={[PANEL_SURFACE_CLASS, "mb-lg p-lg"]}>
    <h3 class={MINOR_HEADING_CLASS}>{group.heading}</h3>
    <ul class={LIST_CLASS}>
      {group.items.map((item) => (
        <li class={LIST_ITEM_CLASS}>
          <a class={BASE_LINK_CLASS} href={resolveGroupHref(item.url)}>{item.title}</a>
        </li>
      ))}
    </ul>
  </section>
))}
