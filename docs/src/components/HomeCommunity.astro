---
import InlineMarkdownText from "./InlineMarkdownText.astro";
import { BASE_LINK_CLASS, LIST_CLASS, LIST_ITEM_CLASS, MINOR_HEADING_CLASS, SMALL_HEADING_CLASS } from "../shared/ui/tailwind";

interface ParatranzProject {
  name: string;
  url: string;
}

interface Props {
  teamJoinDescription?: string;
  paratranzProjects: ParatranzProject[];
}

const { teamJoinDescription, paratranzProjects }: Props = Astro.props;
---

<h3 class={MINOR_HEADING_CLASS}>Joining the Millennium Dawn Development Team</h3>
{teamJoinDescription && <InlineMarkdownText text={teamJoinDescription} />}

<h3 class={MINOR_HEADING_CLASS}>Translations</h3>
<h4 class={SMALL_HEADING_CLASS}>Paratranz Projects</h4>
<ul class={LIST_CLASS}>
  {paratranzProjects.map((project) => (
    <li class={LIST_ITEM_CLASS}>
      <a class={BASE_LINK_CLASS} href={project.url}>{project.name}</a>
    </li>
  ))}
</ul>
