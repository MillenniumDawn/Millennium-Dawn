---
import ResponsiveImage from "./ResponsiveImage.astro";
import { slugifyText } from "../shared/lib/slugs";

interface RoadmapImage {
  src: string;
  alt: string;
  width: number;
  height: number;
  loading?: "lazy" | "eager";
}

interface Roadmap {
  title: string;
  paragraphs?: string[];
  image: RoadmapImage;
}

interface Props {
  roadmaps: Roadmap[];
}

const { roadmaps }: Props = Astro.props;
---

<h2 id="roadmap-images">Roadmap Images</h2>
{roadmaps.map((roadmap) => (
  <>
    <h3 id={slugifyText(roadmap.title)}>{roadmap.title}</h3>
    {(roadmap.paragraphs ?? []).map((paragraph) => (
      <p>{paragraph}</p>
    ))}
    <ResponsiveImage
      src={roadmap.image.src}
      alt={roadmap.image.alt}
      width={roadmap.image.width}
      height={roadmap.image.height}
      loading={roadmap.image.loading}
    />
  </>
))}
