---
import { withBase } from "../lib/urls";
import { slugifyText } from "../shared/lib/slugs";

interface ResourceItem {
  title: string;
  url: string;
}

interface ResourceGroup {
  heading: string;
  items: ResourceItem[];
}

interface Props {
  groups: ResourceGroup[];
}

const { groups }: Props = Astro.props;
---

{groups.map((group) => (
  <>
    <h3 id={slugifyText(group.heading)}>{group.heading}</h3>
    <ul>
      {group.items.map((item) => {
        const href = item.url.includes("://") ? item.url : withBase(item.url);
        return (
          <li>
            <a href={href}>{item.title}</a>
          </li>
        );
      })}
    </ul>
  </>
))}
