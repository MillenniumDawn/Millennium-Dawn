guiTypes = {
	containerWindowType = {
		name = "show_devastation_meter"
		position = { x = 0 y = 5%% }
		size = { width = 640 height = 440 }
		clipping = no
		moveable = no

		#  Title 
		textBoxType = {
			name = "devastation_title_text"
			text = "DEVASTATION_METER_TITLE" # "THERE IS NOTHING LEFT TO BURN"
			position = { x = 50%% y = 0 }
			size = { width = 600 height = 26 }
			format = centre
			font = "hoi_20b"
		}

		textBoxType = {
			name = "devastation_subtitle_text"
			text = "DEVASTATION_METER_SUBTITLE" # "DEVASTATION LEVEL"
			position = { x = 0 y = 26 }
			size = { width = 600 height = 18 }
			format = centre
			font = "hoi_14"
		}

		#  The bar itself, with a dynamic hover tooltip 
		iconType = {
			name = "devastation_bar"
			spriteType = "GFX_devastation_damage"
			position = { x = 20 y = 52 }
			pdx_tooltip = "[devastation_tooltip]"
		}

		#  Threshold tick labels under the bar 
		textBoxType = {
			name = "devastation_tick_damage"
			text = "DEVASTATION_LEVEL_DAMAGE"
			position = { x = 20 y = 84 }
			size = { width = 150 height = 16 }
			format = left
			font = "hoi_14"
		}
		textBoxType = {
			name = "devastation_tick_ravaged"
			text = "DEVASTATION_LEVEL_RAVAGED"
			position = { x = 170 y = 84 }
